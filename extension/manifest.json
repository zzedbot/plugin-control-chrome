{
  "manifest_version": 3,
  "name": "Lingee Chrome Agent Bridge",
  "version": "0.1.17",
  "description": "Allows explicitly authorized local AI agents to control Chrome through a native bridge.",
  "icons": {
    "48": "icons/lingee-48.png"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "debugger",
    "downloads",
    "history",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["icons/lingee-48.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Lingee Chrome Agent Bridge",
    "default_icon": {
      "48": "icons/lingee-48.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "incognito": "split"
}
