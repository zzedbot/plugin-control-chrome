{
  "manifest_version": 3,
  "name": "Universal Chrome Agent Bridge",
  "version": "0.1.12",
  "description": "Allows explicitly authorized local AI agents to control Chrome through a native bridge.",
  "permissions": [
    "alarms",
    "bookmarks",
    "debugger",
    "downloads",
    "history",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Universal Chrome Agent Bridge",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "incognito": "split"
}
